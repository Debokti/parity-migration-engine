# Parity deployment template. Copy to .env and fill secrets locally.
# NEVER commit .env (see .gitignore). Compose reads this file via env_file.

# --- LLM inference (parity-engine/config.py; all via os.getenv) ---
# Provider switch: meta | fireworks | baseten
PARITY_LLM_PROVIDER=meta
# Meta (muse-spark-1.3) uses MODEL_API_KEY, falling back to META_API_KEY.
MODEL_API_KEY=
META_API_KEY=
# Fireworks (muse-spark-open) for Angular generation.
FIREWORKS_API_KEY=
# Baseten (meta-models/muse-spark-open-1026) for repairs.
BASETEN_API_KEY=
# Optional model/endpoint overrides (defaults already point at the models above).
#PRIMARY_MODEL=muse-spark-1.3
#FIREWORKS_MODEL=muse-spark-open
#BASETEN_MODEL=meta-models/muse-spark-open-1026
#META_BASE_URL=https://api.meta.ai/v1
#FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
#BASETEN_BASE_URL=https://inference.baseten.co/v1
# Optional Modal sandbox.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Service topology (compose + local runs) ---
BACKEND_PORT=8080
MFE_PORT=4200
LEGACY_BASE_URL=http://localhost:8080
TARGET_BASE_URL=http://localhost:4200
# Origin of the federated MFE as seen by browsers (popup remoteEntry/iframe).
MFE_ORIGIN=http://localhost:4200
# Backend origin as seen by the MFE nginx proxy (compose service DNS).
BACKEND_ORIGIN=http://backend:8080

# --- Backend production (legacy-jsp) ---
# production disables /__parity/* dev endpoints; use "" for parity test runs.
PARITY_ENV=
# HMAC secret binding JSESSIONID<->Bearer tokens. REQUIRED in production.
PARITY_BRIDGE_SECRET=
# Comma-separated CORS allowlist for /api/* (default when empty: MFE dev origin).
CORS_ALLOWED_ORIGINS=http://localhost:4200
# H2 file database inside the backend container (backed by a volume).
SCF_DB_URL=jdbc:h2:file:/data/scf-db;DB_CLOSE_DELAY=-1
